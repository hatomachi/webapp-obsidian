{
  "name": "Obsidian Web App",
  "short_name": "Obsidian",
  "description": "Lightweight Obsidian Mobile Web Viewer and Editor with GitHub API and Cloudflare Pages",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#161618",
  "theme_color": "#161618",
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/obsidian.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ]
}
